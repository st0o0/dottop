<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\dottop.Core\dottop.Core.csproj" />
        <ProjectReference Include="..\dottop.Plugin.Abstractions\dottop.Plugin.Abstractions.csproj" />
        <ProjectReference Include="..\dottop.Windows\dottop.Windows.csproj" />
        <ProjectReference Include="..\dottop.Linux\dottop.Linux.csproj" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Akka.Logger.Serilog" Version="1.5.67" />
        <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.8" />
        <PackageReference Include="Akka.Hosting" Version="1.5.68" />
        <PackageReference Include="Serilog.Extensions.Hosting" Version="10.0.0" />
        <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
        <PackageReference Include="Servus" Version="0.34.0" />
        <ProjectReference Include="..\..\lib\termina\src\Termina\Termina.csproj" />
    </ItemGroup>

    <ItemGroup>
        <EmbeddedResource Update="Resources\Strings.resx">
            <Generator>PublicResXFileCodeGenerator</Generator>
            <LastGenOutput>Strings.Designer.cs</LastGenOutput>
        </EmbeddedResource>
        <EmbeddedResource Update="Resources\Strings.de.resx" />
    </ItemGroup>

    <!-- Copy plugin DLLs into the App output so PluginLoader can discover them at runtime -->
    <Target Name="CopyPlugins" AfterTargets="Build">
        <ItemGroup>
            <PluginFiles Include="..\dottop.Plugin.Docker\bin\$(Configuration)\$(TargetFramework)\dottop.Plugin.Docker.dll"
                         Condition="Exists('..\dottop.Plugin.Docker\bin\$(Configuration)\$(TargetFramework)\dottop.Plugin.Docker.dll')" />
            <PluginFiles Include="..\dottop.Plugin.Docker\bin\$(Configuration)\$(TargetFramework)\Docker.DotNet.dll"
                         Condition="Exists('..\dottop.Plugin.Docker\bin\$(Configuration)\$(TargetFramework)\Docker.DotNet.dll')" />
            <PluginFiles Include="..\dottop.Plugin.Docker\bin\$(Configuration)\$(TargetFramework)\Docker.DotNet.Enhanced.dll"
                         Condition="Exists('..\dottop.Plugin.Docker\bin\$(Configuration)\$(TargetFramework)\Docker.DotNet.Enhanced.dll')" />
        </ItemGroup>
        <Copy SourceFiles="@(PluginFiles)" DestinationFolder="$(OutputPath)" SkipUnchangedFiles="true" />
    </Target>

</Project>
