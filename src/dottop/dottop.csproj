        <PackageReference Include="Akka.Hosting" Version="1.5.68"/>
        <PackageReference Include="System.ServiceProcess.ServiceController" Version="10.0.8"/>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Termina" Version="0.10.2"/>
    </ItemGroup>

</Project>
