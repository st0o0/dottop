<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Hardware.Info.AOT" Version="110.0.0.1"/>
        <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.8"/>
        <PackageReference Include="Akka.Hosting" Version="1.5.68"/>
        <PackageReference Include="System.ServiceProcess.ServiceController" Version="10.0.8" Condition="$([MSBuild]::IsOSPlatform('Windows'))"/>
        <PackageReference Include="System.Management" Version="10.0.8" Condition="$([MSBuild]::IsOSPlatform('Windows'))"/>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Termina" Version="0.10.2"/>
    </ItemGroup>

    <ItemGroup>
        <EmbeddedResource Update="Resources\Strings.resx">
            <Generator>ResXFileCodeGenerator</Generator>
            <LastGenOutput>Strings.Designer.cs</LastGenOutput>
        </EmbeddedResource>
        <EmbeddedResource Update="Resources\Strings.de.resx" />
    </ItemGroup>

</Project>
